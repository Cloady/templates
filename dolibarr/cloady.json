{
  "category": "Productivity",
  "name": "Dolibarr",
  "hint": "ERP and CRM for invoices, orders, stock and accounting",
  "version": "24.0.1",
  "envSchema": {
    "ADMIN_LOGIN": {
      "title": "Admin username",
      "default": "admin"
    },
    "ADMIN_PASSWORD": {
      "title": "Admin password",
      "secret": true,
      "generate": "password:24"
    },
    "DB_PASSWORD": {
      "secret": true,
      "generate": "password:32"
    },
    "DB_ROOT_PASSWORD": {
      "secret": true,
      "generate": "password:32"
    },
    "INSTANCE_UNIQUE_ID": {
      "secret": true,
      "generate": "hex:16"
    },
    "PUBLIC_URL": {
      "default": "${CLOADY_PRIMARY_URL}"
    }
  },
  "icon": "./icon.svg"
}
