{
  "category": "Databases",
  "version": "18.6",
  "envSchema": {
    "POSTGRES_DB": {
      "title": "Database",
      "default": "app"
    },
    "POSTGRES_USER": {
      "title": "Username",
      "default": "cloady"
    },
    "POSTGRES_PASSWORD": {
      "title": "Password",
      "secret": true,
      "generate": "password:24"
    },
    "POSTGRES_TLS": {
      "title": "TLS",
      "description": "Encrypt connections with a self-signed certificate. Clients connect with sslmode=require.",
      "enum": [
        "on",
        "off"
      ],
      "default": "on"
    }
  },
  "icon": "./icon.svg"
}
