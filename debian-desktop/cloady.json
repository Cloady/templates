{
  "category": "Desktops",
  "version": "latest",
  "name": "Debian Desktop",
  "hint": "Debian in your browser: Xfce, KDE, MATE or i3",
  "envSchema": {
    "CUSTOM_USER": {
      "title": "Username",
      "default": "admin"
    },
    "PASSWORD": {
      "title": "Password",
      "secret": true,
      "generate": "password:24"
    },
    "TZ": {
      "title": "Time zone",
      "default": "Etc/UTC"
    }
  },
  "profileSchema": {
    "desktop": {
      "title": "Desktop",
      "type": "string",
      "enum": [
        "xfce",
        "kde",
        "mate",
        "i3"
      ],
      "default": "xfce"
    }
  },
  "icon": "./icon.svg"
}
