{
  "category": "AI & LLM",
  "version": "3.1.4",
  "envSchema": {
    "FLOWISE_PASSWORD": {
      "title": "Flowise Password",
      "secret": true,
      "generate": "password:24"
    },
    "FLOWISE_USERNAME": {
      "title": "Flowise Username"
    },
    "LANGCHAIN_API_KEY": {
      "title": "(Optional) Langchain API Key",
      "secret": true,
      "generate": "password:24"
    },
    "LANGCHAIN_PROJECT": {
      "title": "(Optional) Langchain Project"
    },
    "LANGCHAIN_ENDPOINT": {
      "title": "(Optional) Langchain Endpoint"
    },
    "LANGCHAIN_TRACING_V2": {
      "title": "Enable Langchain Tracing v2"
    },
    "DISABLE_FLOWISE_TELEMETRY": {
      "title": "Disable Flowise telemetry"
    },
    "FLOWISE_SECRETKEY_OVERWRITE": {
      "secret": true,
      "generate": "password:32"
    }
  },
  "icon": "./icon.png"
}
