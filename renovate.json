{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["docker-compose", "github-actions"],
  "prHourlyLimit": 20,
  "prConcurrentLimit": 40,
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "none",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "One pull request per template, named after it, carrying every image update in the folder; follow-image-versions moves its cloady.json version after the merge",
      "matchManagers": ["docker-compose"],
      "groupName": "{{parentDir}} template",
      "commitMessageTopic": "{{parentDir}} template"
    },
    {
      "description": "Minor, patch and digest updates merge once the template's smoke test passes",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Databases, caches, search engines and brokers never change major in a template",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": [
        "/(^|/)(postgres|postgis|pgvector|timescaledb|mariadb|mysql|mysql-server|mongo|mongodb-community-server|redis|rejson|valkey|keydb|memcached|dragonfly|clickhouse-server|meilisearch|elasticsearch|opensearch|typesense|qdrant|weaviate|neo4j|couchdb|cassandra|influxdb|rabbitmq|nats|kafka|eclipse-mosquitto|emqx)$/"
      ],
      "enabled": false
    },
    {
      "description": "These templates name their major in the catalog",
      "matchFileNames": ["n8n/**", "zipline/**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Supabase keeps the set of images its upstream compose pins",
      "matchFileNames": ["supabase/**"],
      "enabled": false
    },
    {
      "description": "LinuxServer build tags such as v6.31.1-ls33",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["**/linuxserver/**"],
      "matchCurrentValue": "/-ls\\d+$/",
      "versioning": "regex:^(?<compatibility>v?)(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "LinuxServer also pushes date-stamped tags such as 26.09.20260929 beside the real versions",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["**/linuxserver/**"],
      "allowedVersions": "!/\\.20\\d{6}$/"
    },
    {
      "description": "LinuxServer majors are mostly unrelated numbering, such as calibre-web 0.6 to 5.33",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["**/linuxserver/**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Action updates merge on their own, except a new major",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    }
  ]
}
