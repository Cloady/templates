{
  "category": "Storage",
  "version": "4.16.0",
  "envSchema": {
    "JWT_SECRET": {
      "secret": true,
      "generate": "password:64"
    },
    "DB_PASSWORD": {
      "secret": true,
      "generate": "password:32"
    },
    "INTERNAL_IP": {
      "title": "INTERNAL_IP",
      "default": ""
    },
    "APP_PROTOCOL": {
      "default": "http"
    },
    "ENABLE_EMAIL": {
      "title": "Enable email verification for new signups",
      "default": "false"
    },
    "LOCAL_DOMAIN": {
      "title": "LOCAL_DOMAIN",
      "default": ""
    },
    "ALLOW_SIGNUPS": {
      "title": "Allow new registrations",
      "default": "false"
    },
    "BREVO_API_KEY": {
      "title": "Brevo API key",
      "secret": true,
      "generate": "password:24"
    },
    "PASSWORD_SALT": {
      "secret": true,
      "generate": "password:32"
    }
  },
  "icon": "./icon.png"
}
