{
  "category": "Backends",
  "version": "0.8.3",
  "envSchema": {
    "REGION": {
      "title": "Storage region",
      "default": "stub"
    },
    "ANON_KEY": {
      "generate": "jwt:anon:JWT_SECRET"
    },
    "META_HOST": {
      "default": "${CLOADY_HOST_META}"
    },
    "REST_HOST": {
      "default": "${CLOADY_HOST_REST}"
    },
    "SMTP_HOST": {
      "title": "SMTP host",
      "default": ""
    },
    "SMTP_PASS": {
      "title": "SMTP password",
      "secret": true,
      "default": ""
    },
    "SMTP_PORT": {
      "title": "SMTP port",
      "default": "587"
    },
    "SMTP_USER": {
      "title": "SMTP user",
      "default": ""
    },
    "JWT_EXPIRY": {
      "title": "JWT expiry (seconds)",
      "default": "3600"
    },
    "JWT_SECRET": {
      "secret": true,
      "generate": "password:40"
    },
    "PUBLIC_URL": {
      "default": "${CLOADY_PRIMARY_URL}"
    },
    "API_GW_HOST": {
      "default": "${CLOADY_HOST_API_GW}"
    },
    "IMGPROXY_HOST": {
      "default": "${CLOADY_HOST_IMGPROXY}"
    },
    "POSTGRES_HOST": {
      "default": "${CLOADY_HOST_DB}"
    },
    "VAULT_ENC_KEY": {
      "secret": true,
      "generate": "password:32"
    },
    "DISABLE_SIGNUP": {
      "type": "boolean",
      "title": "Disable signups",
      "default": false
    },
    "OPENAI_API_KEY": {
      "title": "OpenAI API key (Studio SQL assistant)",
      "secret": true,
      "default": ""
    },
    "SECRET_KEY_BASE": {
      "secret": true,
      "generate": "password:64"
    },
    "GLOBAL_S3_BUCKET": {
      "title": "Storage bucket name",
      "default": "stub"
    },
    "PGRST_DB_SCHEMAS": {
      "title": "Exposed schemas",
      "default": "public,graphql_public"
    },
    "POOLER_TENANT_ID": {
      "default": "cloady"
    },
    "SERVICE_ROLE_KEY": {
      "secret": true,
      "generate": "jwt:service_role:JWT_SECRET"
    },
    "SMTP_ADMIN_EMAIL": {
      "title": "SMTP admin email",
      "default": ""
    },
    "SMTP_SENDER_NAME": {
      "title": "SMTP sender name",
      "default": "Supabase"
    },
    "POSTGRES_PASSWORD": {
      "title": "Database password",
      "secret": true,
      "generate": "password:24"
    },
    "RESPONSE_S_MAXAGE": {
      "title": "Storage CDN cache time (seconds)",
      "description": "The s-maxage Storage sends with files, for a CDN in front of it.",
      "default": "0"
    },
    "STORAGE_LOG_LEVEL": {
      "title": "Storage log level",
      "enum": [
        "fatal",
        "error",
        "warn",
        "info",
        "debug",
        "trace"
      ],
      "default": "info"
    },
    "STORAGE_TENANT_ID": {
      "title": "Storage tenant id",
      "default": "stub"
    },
    "TUS_URL_EXPIRY_MS": {
      "title": "Storage resumable upload URL lifetime (ms)",
      "default": "3600000"
    },
    "DASHBOARD_PASSWORD": {
      "title": "Dashboard password",
      "secret": true,
      "generate": "password:24"
    },
    "DASHBOARD_USERNAME": {
      "title": "Dashboard username",
      "default": "supabase"
    },
    "IMGPROXY_AUTO_WEBP": {
      "type": "boolean",
      "title": "Imgproxy auto WebP",
      "default": true
    },
    "PG_META_CRYPTO_KEY": {
      "secret": true,
      "generate": "password:32"
    },
    "ANON_KEY_ASYMMETRIC": {
      "secret": true,
      "default": ""
    },
    "ENABLE_EMAIL_SIGNUP": {
      "type": "boolean",
      "title": "Enable email signup",
      "default": true
    },
    "ENABLE_PHONE_SIGNUP": {
      "type": "boolean",
      "title": "Enable phone signup",
      "default": false
    },
    "POOLER_DB_POOL_SIZE": {
      "title": "Pooler DB pool size",
      "default": "5"
    },
    "REALTIME_DB_ENC_KEY": {
      "title": "Realtime encryption key",
      "description": "Encrypts the database credentials Realtime keeps in its _realtime schema. Exactly 16 characters.",
      "secret": true,
      "generate": "hex:8"
    },
    "S3_PROTOCOL_ENABLED": {
      "type": "boolean",
      "title": "Enable the Storage S3 protocol",
      "default": true
    },
    "SUPABASE_SECRET_KEY": {
      "secret": true,
      "default": ""
    },
    "FUNCTIONS_VERIFY_JWT": {
      "type": "boolean",
      "title": "Edge functions verify JWT",
      "default": false
    },
    "ENABLE_ANONYMOUS_USERS": {
      "type": "boolean",
      "title": "Enable anonymous users",
      "default": false
    },
    "MAILER_URLPATHS_INVITE": {
      "default": "/auth/v1/verify"
    },
    "POOLER_MAX_CLIENT_CONN": {
      "title": "Pooler max client connections",
      "default": "100"
    },
    "STUDIO_DEFAULT_PROJECT": {
      "title": "Default project",
      "default": "Default Project"
    },
    "UPLOAD_FILE_SIZE_LIMIT": {
      "title": "Storage upload size limit (bytes)",
      "default": "52428800"
    },
    "ADDITIONAL_REDIRECT_URLS": {
      "title": "Additional redirect URLs",
      "default": ""
    },
    "ENABLE_EMAIL_AUTOCONFIRM": {
      "type": "boolean",
      "title": "Auto-confirm email",
      "default": true
    },
    "ENABLE_PHONE_AUTOCONFIRM": {
      "type": "boolean",
      "title": "Auto-confirm phone",
      "default": false
    },
    "IMGPROXY_REQUEST_TIMEOUT": {
      "title": "Image transformation timeout (seconds)",
      "default": "15"
    },
    "MAILER_URLPATHS_RECOVERY": {
      "default": "/auth/v1/verify"
    },
    "POOLER_DEFAULT_POOL_SIZE": {
      "title": "Pooler default pool size",
      "default": "20"
    },
    "SUPABASE_PUBLISHABLE_KEY": {
      "secret": true,
      "default": ""
    },
    "S3_PROTOCOL_ACCESS_KEY_ID": {
      "secret": true,
      "generate": "hex:16"
    },
    "STORAGE_DB_MAX_CONNECTIONS": {
      "title": "Storage database connections",
      "default": "20"
    },
    "STORAGE_RENDER_MAX_REQ_SEC": {
      "title": "Image render rate limit (requests per second)",
      "default": "5"
    },
    "TUS_MAX_CONCURRENT_UPLOADS": {
      "title": "Storage concurrent resumable uploads",
      "default": "500"
    },
    "SERVICE_ROLE_KEY_ASYMMETRIC": {
      "secret": true,
      "default": ""
    },
    "STUDIO_DEFAULT_ORGANIZATION": {
      "title": "Default organization",
      "default": "Default Organization"
    },
    "IMAGE_TRANSFORMATION_ENABLED": {
      "type": "boolean",
      "title": "Enable image transformations",
      "default": true
    },
    "MAILER_URLPATHS_CONFIRMATION": {
      "default": "/auth/v1/verify"
    },
    "MAILER_URLPATHS_EMAIL_CHANGE": {
      "default": "/auth/v1/verify"
    },
    "STORAGE_DB_STATEMENT_TIMEOUT": {
      "title": "Storage database statement timeout (ms)",
      "default": "30000"
    },
    "STORAGE_RATE_LIMITER_ENABLED": {
      "type": "boolean",
      "title": "Enable the image render rate limiter",
      "default": false
    },
    "GOTRUE_EXTERNAL_GOOGLE_SECRET": {
      "title": "Google OAuth client secret",
      "secret": true
    },
    "S3_PROTOCOL_ACCESS_KEY_SECRET": {
      "secret": true,
      "generate": "hex:32"
    },
    "GOTRUE_EXTERNAL_GOOGLE_ENABLED": {
      "type": "boolean",
      "title": "Google sign-in enabled",
      "default": false
    },
    "UPLOAD_FILE_SIZE_LIMIT_STANDARD": {
      "title": "Storage standard upload size limit (bytes)",
      "description": "A lower limit for uploads that don't use the resumable endpoint. 0 applies the upload size limit alone.",
      "default": "0"
    },
    "GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID": {
      "title": "Google OAuth client id"
    },
    "UPLOAD_SIGNED_URL_EXPIRATION_TIME": {
      "title": "Storage signed upload URL lifetime (seconds)",
      "default": "60"
    },
    "GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI": {
      "title": "Google OAuth redirect URI"
    },
    "IMAGE_TRANSFORMATION_LIMIT_MAX_SIZE": {
      "title": "Image transformation maximum size (px)",
      "default": "2000"
    },
    "IMAGE_TRANSFORMATION_LIMIT_MIN_SIZE": {
      "title": "Image transformation minimum size (px)",
      "default": "1"
    }
  },
  "icon": "./icon.svg"
}
