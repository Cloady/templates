{
  "category": "Security",
  "envSchema": {
    "PUBLIC_URL": {
      "default": "${CLOADY_PRIMARY_URL}"
    },
    "ADMIN_TOKEN": {
      "title": "Admin page token",
      "secret": true,
      "generate": "hex:32",
      "description": "Unlocks /admin. Keep it safe."
    },
    "SIGNUPS_ALLOWED": {
      "type": "boolean",
      "title": "Allow signups",
      "default": true,
      "description": "Disable after creating your account."
    }
  },
  "icon": "./icon.svg"
}
